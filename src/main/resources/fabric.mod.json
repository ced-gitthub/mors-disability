{
	"schemaVersion": 1,
	"id": "mors-disability",
	"version": "${version}",
	"name": "Mors Disability",
	"description": "Gain a random disability on a timer per player. Severity-based timers, configured in config/mors-disability.json (OP only). Inspired by the Disabilities mod by OddSense.",
	"authors": ["Ced"],
	"contributors": ["OddSense (author of the Disabilities mod that inspired this one)"],
	"contact": {"homepage": "https://modrinth.com/mod/disabilities"},
	"license": "MIT",
	"icon": "assets/mors-disability/icon.png",
	"environment": "*",
	"mixins": [{"config": "mors-disability.client.mixins.json", "environment": "client"}],
	"entrypoints": {
		"main": ["com.ced.disabilities.DisabilityMod"],
		"client": ["com.ced.disabilities.client.DisabilityClient"],
		"voicechat": ["com.ced.disabilities.voice.VoicechatIntegration"]
	},
	"suggests": {
		"voicechat": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
