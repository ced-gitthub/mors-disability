{
	"schemaVersion": 1,
	"id": "mors-disability",
	"version": "${version}",
	"name": "Mors Disability",
	"description": "Gain a random disability on a timer per player. Severity-based timers, configured in config/mors-disability.json (OP only).",
	"authors": ["Mors"],
	"contact": {"homepage": "https://modrinth.com/mod/mors-disability", "donation": "https://ko-fi.com/morsvald"},
	"custom": {"modmenu": {"links": {"modmenu.donate": "https://ko-fi.com/morsvald"}}},
	"license": "MIT",
	"icon": "assets/mors-disability/icon.png",
	"environment": "*",
	"mixins": [{"config": "mors-disability.client.mixins.json", "environment": "client"}],
	"entrypoints": {
		"main": ["com.mors.disabilities.DisabilityMod"],
		"client": ["com.mors.disabilities.client.DisabilityClient"],
		"voicechat": ["com.mors.disabilities.voice.VoicechatIntegration"]
	},
	"suggests": {
		"voicechat": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
